# Server Configuration
# The port Express will listen on
PORT=5000

# Server environment: development or production
NODE_ENV=development

# Database Connection
# Replace with your PostgreSQL connection URL. Prisma uses this to connect.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=SCHEMA
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/uma_home_kitchen?schema=public

# JWT Security
# Secret key used for signing and verifying JSON Web Tokens
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production

# Frontend Origin
# Allowed origin for CORS requests in production (e.g. your hosted domain)
FRONTEND_URL=http://localhost:3000
